---
import { formatTimeAgo, formatFullDate } from '../utils/date';

interface Props {
  title: string;
  description: string;
  pubDate: Date | string;
  category: string;
  thumbnail: string;
  author: string;
  slug: string;
  tags?: string[];
  readTime?: string;
}

const {
  title,
  description,
  pubDate,
  category,
  thumbnail,
  author,
  slug,
  tags = [],
  readTime = '4 min read',
} = Astro.props;

// Date calculations
const dateObj = new Date(pubDate);
const timeAgo = formatTimeAgo(dateObj);
const formattedDate = formatFullDate(dateObj);

// Category badge theme
const getBadgeClass = (cat: string) => {
  const c = cat.toLowerCase();
  if (c.includes('leak')) {
    return 'bg-pink-500/10 text-[#ff3388] border-[#ff3388]/30 shadow-[0_0_8px_rgba(255,51,136,0.25)]';
  }
  if (c.includes('patch')) {
    return 'bg-neon-cyan/10 text-neon-cyan border-neon-cyan/30 shadow-[0_0_8px_rgba(0,240,255,0.25)]';
  }
  if (c.includes('hardware')) {
    return 'bg-amber-400/10 text-amber-400 border-amber-400/30 shadow-[0_0_8px_rgba(251,191,36,0.25)]';
  }
  if (c.includes('review')) {
    return 'bg-purple-400/10 text-purple-400 border-purple-400/30 shadow-[0_0_8px_rgba(192,132,252,0.25)]';
  }
  return 'bg-neon-green/10 text-neon-green border-neon-green/30 shadow-[0_0_8px_rgba(0,255,102,0.25)]';
};
---

<article class="group relative flex flex-col bg-dark-card border border-dark-border hover:border-neon-green/50 rounded-xl overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-card-elevated">
  <!-- Top corner glowing cyber accent marker -->
  <div class="absolute top-0 right-0 w-8 h-8 pointer-events-none overflow-hidden z-10">
    <div class="absolute top-0 right-0 w-2 h-2 bg-dark-border group-hover:bg-neon-green transition-colors duration-300"></div>
  </div>

  <!-- Image Thumbnail Container -->
  <a href={`/news/${slug}`} class="relative aspect-video w-full overflow-hidden bg-dark-bg block" tabindex="-1">
    <img
      src={thumbnail}
      alt={title}
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <!-- Subtle dark vignette over thumbnail -->
    <div class="absolute inset-0 bg-gradient-to-t from-dark-card via-transparent to-transparent opacity-80"></div>
    
    <!-- Category Badge Floating on Image -->
    <div class="absolute top-3 left-3">
      <span class={`inline-flex items-center px-2.5 py-0.5 rounded text-[11px] font-mono font-semibold tracking-wider uppercase border backdrop-blur-md ${getBadgeClass(category)}`}>
        {category}
      </span>
    </div>

    <!-- Read Time pill on bottom right of image -->
    <div class="absolute bottom-3 right-3">
      <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono text-dark-heading bg-dark-bg/80 backdrop-blur-sm border border-dark-border/60">
        {readTime}
      </span>
    </div>
  </a>

  <!-- Card Body -->
  <div class="flex flex-1 flex-col p-5">
    
    <!-- Meta row (Relative time & Author) -->
    <div class="flex items-center justify-between text-xs font-mono text-dark-muted mb-3">
      <time
        datetime={dateObj.toISOString()}
        title={`Published on ${formattedDate}`}
        class="flex items-center gap-1.5 text-neon-green"
      >
        <svg class="w-3.5 h-3.5 text-neon-green/80" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <circle cx="12" cy="12" r="10" stroke-width="2"></circle>
          <polyline points="12 6 12 12 16 14" stroke-width="2"></polyline>
        </svg>
        <span class="font-bold text-white/90">{timeAgo}</span>
        <span class="text-dark-muted/60 hidden sm:inline">• {formattedDate}</span>
      </time>
      <span class="truncate max-w-[120px] text-dark-text">{author}</span>
    </div>

    <!-- Title (Clean readable typography with tracking-tight) -->
    <h3 class="font-display font-bold text-lg leading-snug text-dark-heading group-hover:text-neon-green transition-colors duration-200 line-clamp-2 mb-2 tracking-tight">
      <a href={`/news/${slug}`} class="focus:outline-none focus:underline">
        {title}
      </a>
    </h3>

    <!-- Description -->
    <p class="text-sm text-dark-text line-clamp-2 leading-relaxed mb-4 flex-1">
      {description}
    </p>

    <!-- Card Footer: Tag chips & Read CTA -->
    <div class="pt-3 border-t border-dark-border/60 flex items-center justify-between text-xs">
      <div class="flex items-center gap-1.5 flex-wrap">
        {tags.slice(0, 2).map((t) => (
          <span class="px-1.5 py-0.5 rounded bg-dark-bg text-[10px] font-mono text-dark-muted border border-dark-border/50">
            #{t}
          </span>
        ))}
      </div>
      
      <a
        href={`/news/${slug}`}
        class="inline-flex items-center gap-1 font-mono font-semibold text-xs text-neon-green group-hover:text-white transition-colors"
      >
        <span>Read Post</span>
        <svg class="w-3 h-3 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

  </div>
</article>
