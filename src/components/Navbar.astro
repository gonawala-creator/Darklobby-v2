---
import navigationData from '../content/settings/navigation.json';

interface Props {
  currentCategory?: string;
}

const { currentCategory = '' } = Astro.props;

// Dynamically read navigation tabs from JSON configuration
const navItems = (navigationData?.items || []).filter((item) => item.visible !== false);
---

<header class="sticky top-0 z-50 w-full border-b border-dark-border/80 bg-dark-bg/90 backdrop-blur-md transition-all duration-300">
  <!-- Top ticker / system bar -->
  <div class="hidden md:flex items-center justify-between px-4 lg:px-8 py-1 bg-dark-card/50 border-b border-dark-border/40 text-[11px] font-mono text-dark-muted">
    <div class="flex items-center gap-3">
      <span class="inline-flex items-center gap-1.5 text-neon-green">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-neon-green opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-neon-green"></span>
        </span>
        SYS: INTEL TRANSMISSION ACTIVE
      </span>
      <span class="text-dark-border">|</span>
      <span>NODE: US-EAST-DL9</span>
      <span class="text-dark-border">|</span>
      <span>FREQ: 144.92 MHz</span>
    </div>
    <div class="flex items-center gap-4">
      <span class="text-dark-text/70">darklobby.site // SECURE ACCESS PROTOCOL</span>
      <span class="text-neon-cyan">v2.4.0</span>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-neon-green/50 rounded-lg p-1">
        <div class="relative flex items-center justify-center w-10 h-10 rounded bg-dark-card border border-dark-border group-hover:border-neon-green/60 transition-colors duration-300 overflow-hidden shadow-sm">
          <div class="absolute inset-0 bg-gradient-to-br from-neon-green/10 to-neon-cyan/5 opacity-50 group-hover:opacity-100 transition-opacity"></div>
          <!-- Cyber Crosshair / Shield Icon -->
          <svg class="w-6 h-6 text-neon-green transform group-hover:scale-110 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
            <polyline points="2 17 12 22 22 17"></polyline>
            <polyline points="2 12 12 17 22 12"></polyline>
          </svg>
        </div>
        <div class="flex flex-col">
          <div class="flex items-center gap-1.5">
            <span class="font-brand font-extrabold text-xl sm:text-2xl tracking-wider text-white group-hover:text-neon-green transition-colors duration-300">
              DARK<span class="text-neon-green">LOBBY</span>
            </span>
          </div>
          <span class="text-[9px] font-mono tracking-widest uppercase text-dark-muted -mt-1 group-hover:text-dark-text transition-colors">
            Gaming Intel & Dispatch
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Main Navigation">
        {navItems.map((item) => (
          <a
            href={item.href}
            data-category-nav={item.category || item.name}
            class="nav-tab-link px-3.5 py-1.5 rounded text-sm font-medium tracking-wide text-dark-text hover:text-white hover:bg-dark-hover border border-transparent hover:border-dark-border transition-all duration-200 cursor-pointer"
          >
            {item.name}
          </a>
        ))}
      </nav>

      <!-- Right CTAs -->
      <div class="hidden sm:flex items-center gap-3">
        <a
          href="/#newsletter"
          class="relative inline-flex items-center gap-2 px-4 py-2 text-xs font-mono font-bold uppercase tracking-wider text-black bg-neon-green hover:bg-[#1aff75] rounded transition-all duration-200 shadow-neon-green hover:shadow-[0_0_25px_rgba(0,255,102,0.6)] transform hover:-translate-y-0.5 active:translate-y-0"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          Intel Alerts
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex items-center lg:hidden">
        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Toggle Navigation Menu"
          aria-expanded="false"
          class="p-2 rounded-lg text-dark-text hover:text-white hover:bg-dark-card border border-dark-border focus:outline-none focus:ring-2 focus:ring-neon-green/50 transition-colors"
        >
          <svg id="menu-icon-open" class="w-6 h-6 block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-dark-border bg-dark-card/95 backdrop-blur-xl px-4 pt-3 pb-6 space-y-2">
    <div class="flex flex-col space-y-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          data-category-nav={item.category || item.name}
          class="nav-tab-link px-3 py-2.5 rounded text-sm font-medium text-dark-heading hover:text-neon-green hover:bg-dark-hover border border-transparent hover:border-dark-border transition-colors flex items-center justify-between cursor-pointer"
        >
          <span>{item.name}</span>
          <span class="text-xs font-mono text-dark-muted">→</span>
        </a>
      ))}
    </div>
    
    <div class="pt-4 border-t border-dark-border flex flex-col gap-2">
      <a
        href="/#newsletter"
        class="w-full text-center py-2.5 text-xs font-mono font-bold uppercase tracking-wider text-black bg-neon-green rounded hover:bg-[#1aff75] transition-colors"
      >
        Subscribe to Intel Alerts
      </a>
      <p class="text-[11px] text-center text-dark-muted font-mono pt-1">
        darklobby.site // All systems nominal
      </p>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-icon-open');
  const closeIcon = document.getElementById('menu-icon-close');

  if (btn && menu && openIcon && closeIcon) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      openIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });

    // Close mobile menu when a navigation item is clicked
    const links = menu.querySelectorAll('a');
    links.forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        openIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      });
    });
  }

  // Handle instant category filtering and smooth scrolling from Navbar tabs
  const navTabLinks = document.querySelectorAll('.nav-tab-link');
  navTabLinks.forEach((link) => {
    link.addEventListener('click', (e) => {
      const category = link.getAttribute('data-category-nav');
      if (!category) return;

      const isHomePage = window.location.pathname === '/' || window.location.pathname === '';
      if (isHomePage) {
        e.preventDefault();

        // Dispatch instant category filter event to index page
        window.dispatchEvent(new CustomEvent('darklobby:filter', { detail: { category } }));

        // Update URL hash without causing a page reload
        const slug = category.toLowerCase().replace(/\s+/g, '-');
        const hash = slug === 'all' || slug === 'all-news' ? '' : `#${slug}`;
        history.pushState(null, '', window.location.pathname + hash);

        // Smoothly scroll down to the articles grid
        const dispatches = document.getElementById('dispatches');
        if (dispatches) {
          dispatches.scrollIntoView({ behavior: 'smooth' });
        }
      }
    });
  });
</script>
