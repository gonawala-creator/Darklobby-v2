---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import AdBanner from '../components/AdBanner.astro';
import StickyBottomAd from '../components/StickyBottomAd.astro';
import adsData from '../content/settings/ads.json';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  articleDate?: string;
  currentCategory?: string;
  showHeaderAd?: boolean;
  showFooterAd?: boolean;
}

const {
  title = 'Dark Lobby | Premier Gaming News, Leaks & Patch Notes',
  description = 'Your high-octane gaming intelligence hub. Verified industry leaks, zero-day patch notes, hardware breakdowns, and competitive dispatches.',
  image = '/images/darklobby-og.jpg',
  articleDate,
  currentCategory,
  showHeaderAd = false,
  showFooterAd = true,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://darklobby.site');
const fullTitle = title.includes('Dark Lobby') ? title : `${title} | Dark Lobby`;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%2300ff66'><polygon points='12 2 2 7 12 12 22 7 12 2'/><polyline points='2 17 12 22 22 17'/><polyline points='2 12 12 17 22 12'/></svg>" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts Preconnect and Stylesheets -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&family=Orbitron:wght@700;800;900&family=Plus+Jakarta+Sans:wght@500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- SEO Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={articleDate ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Dark Lobby" />
    {articleDate && <meta property="article:published_time" content={articleDate} />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Cyber Matrix Meta -->
    <meta name="theme-color" content="#090d16" />

    <!-- Google AdSense Global Publisher & Auto-Ads Script -->
    {adsData?.enabled && adsData?.adsense?.enabled && adsData?.adsense?.clientId && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsData.adsense.clientId}`}
        crossorigin="anonymous"
      ></script>
    )}

    <!-- Netlify Identity Widget for Decap CMS Authentication & Invitations -->
    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  </head>
  <body class="min-h-screen flex flex-col bg-dark-bg text-dark-text antialiased selection:bg-neon-green/20 selection:text-white">
    <!-- Header / Navbar -->
    <Navbar currentCategory={currentCategory} />

    <!-- Optional Global Header Ad Slot -->
    {showHeaderAd && (
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
        <AdBanner slotType="header" />
      </div>
    )}

    <!-- Main Content Container -->
    <main class="flex-1 w-full">
      <slot />
    </main>

    <!-- Global Footer Ad Slot -->
    {showFooterAd && (
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-4">
        <AdBanner slotType="footer" />
      </div>
    )}

    <!-- Footer -->
    <Footer />

    <!-- Netlify Identity Auto-Redirect Script for CMS Administrators -->
    <script is:inline>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on("init", (user) => {
          if (!user) {
            window.netlifyIdentity.on("login", () => {
              document.location.href = "/admin/";
            });
          }
        });
      }
    </script>

    <!-- Non-Intrusive Floating Sponsor Dock (Collapsible with session memory) -->
    <StickyBottomAd />

    <!-- Google AdSense Ad Unit Push Runner -->
    <script is:inline>
      window.addEventListener('load', () => {
        try {
          const ads = document.querySelectorAll('.adsbygoogle:not([data-adsbygoogle-status])');
          ads.forEach(() => {
            (window.adsbygoogle = window.adsbygoogle || []).push({});
          });
        } catch (e) {}
      });
    </script>
  </body>
</html>
